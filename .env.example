# Web, mobil (Capacitor/Expo) ve masaüstü (Tauri/Electron) sürümleri için ortak istemci değişkenleri.
# Bu dosyayı kopyalayıp .env olarak kaydedin ve kendi Supabase proje değerlerinizi girin.
# VITE_ ile başlayan her değer uygulama paketine girer, bu yüzden gizli anahtar buraya yazılmaz.

# Supabase proje adresi (tüm API çağrılarının kök adresi: <URL>/functions/v1 ve <URL>/rest/v1)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "anon public" anahtarı (herkese açık, RLS ile korunur)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Sunucu tarafı gizli anahtarlar (OPENAI_API_KEY, RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY)
# buraya YAZILMAZ. Bunlar Supabase Edge Functions "Secrets" bölümünde tanımlanır.
